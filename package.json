{
  "name": "takeaway-manager",
  "private": true,
  "version": "1.0.0",
  "description": "Takeaway frontend and menu manager created using HTML, CSS, React, Node.js, SQL and Express.js",
  "homepage": "https://github.com/UmarAkhtar/Takeaway-Manager#readme",
  "bugs": {
    "url": "https://github.com/UmarAkhtar/Takeaway-Manager/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UmarAkhtar/Takeaway-Manager.git"
  },
  "license": "ISC",
  "author": "Umar Akhtar",
  "type": "commonjs",
  "main": "index.js",

  "jest": {
  "testPathIgnorePatterns": ["/node_modules/", "/tests/e2e/"]
},


  "scripts": {
    "test": "jest",
    "start": "node server/server.js",
    "dev:server": "node --watch server/server.js",
    "dev:client": "vite",
    "build": "vite build",
    "seed": "node server/seed.js",
    "dev": "concurrently -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "test:e2e": "playwright test"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "express": "^5.2.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.6",
    "@babel/preset-env": "^8.0.6",
    "@playwright/test": "^1.63.0",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-jest": "^30.5.2",
    "concurrently": "^10.0.5",
    "jest": "^30.5.2",
    "vite": "^8.3.1"
  }
}
